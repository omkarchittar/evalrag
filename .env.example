POSTGRES_PASSWORD=local-development-only
EVALRAG_DATABASE_URL=postgresql+psycopg://evalrag:local-development-only@localhost:5433/evalrag
EVALRAG_OPENAI_API_KEY=
EVALRAG_GENERATION_MODEL=gpt-4.1-mini

# Optional extra generation models exposed in query settings (JSON array).
EVALRAG_ADDITIONAL_GENERATION_MODELS=[]

# Local HTTP uses development cookies; deployed HTTPS must use production.
EVALRAG_ENVIRONMENT=development
EVALRAG_ALLOWED_ORIGINS=["http://localhost:3000"]
EVALRAG_UPLOAD_LIMIT_BYTES=10000000
EVALRAG_OPENAI_BASE_URL=https://api.openai.com/v1
