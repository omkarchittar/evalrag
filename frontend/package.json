{
  "name": "evalrag-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "PORT=3000 node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "serve:e2e": "EVALRAG_API_URL=http://127.0.0.1:18080 npm run build && PORT=3110 HOSTNAME=127.0.0.1 node .next/standalone/server.js",
    "format": "prettier --write src tests/*.ts demos/*.ts scripts *.ts *.mjs *.json",
    "format:check": "prettier --check src tests/*.ts demos/*.ts scripts *.ts *.mjs *.json",
    "record:demo": "playwright test --config demo.config.ts"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "typescript": "^5"
  }
}
